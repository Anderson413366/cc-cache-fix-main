# Active local runtime
# The installer does not require this when Claude local auth is already configured.
# test_cache.py can use this for live Claude API validation.
ANTHROPIC_API_KEY=

# Active local installer override
# Leave blank for the repository-supported version in SUPPORTED_CLAUDE_CODE_VERSION.
CC_CACHE_FIX_CLAUDE_VERSION=

# Supabase - Future Ready / Not Active Yet
# Use only if this toolkit grows a hosted dashboard, shared telemetry, auth, or team records.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Admin - Future Ready / Server Only / Not Active Yet
# Never expose this in browser code, public logs, screenshots, or client-side bundles.
SUPABASE_SERVICE_ROLE_KEY=
